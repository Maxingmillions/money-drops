# --- Database (Postgres) ---
# On Vercel, adding the Neon integration sets both of these for you.
# Locally, point them at any Postgres (or paste your Neon URLs here).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/money_drops"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/money_drops"

# --- Sessions ---
# Any long random string. Used to sign the session cookie.
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Solana ---
# devnet | mainnet-beta
NEXT_PUBLIC_SOLANA_CLUSTER="devnet"
# Optional: a dedicated RPC endpoint (Helius, Triton, QuickNode...). Defaults to the public cluster RPC.
NEXT_PUBLIC_SOLANA_RPC=""
# Treasury (custodial escrow v1). Base58-encoded secret key of the wallet that
# receives campaign deposits and pays out claims. Generate one with:
#   npm run treasury:new
TREASURY_SECRET_KEY=""
# Public key of the treasury, shown to creators when funding a campaign.
NEXT_PUBLIC_TREASURY_ADDRESS=""

# --- Dev conveniences ---
# When "true", campaigns activate without an on-chain deposit and claims are
# recorded without a payout. Never enable in production.
DEV_SKIP_FUNDING="true"
# Lets the map simulate your location by tapping (desktop testing).
NEXT_PUBLIC_DEV_LOCATION="true"

# Seed location (prisma/seed.ts). Defaults to Yoyogi Park, Tokyo.
SEED_LAT="35.6717"
SEED_LNG="139.6949"

# --- Privy (sign in with Phantom & other wallets, Google, Apple, email) ---
# Create an app at https://dashboard.privy.io, enable Solana embedded wallets,
# turn on "Identity tokens" under Authentication > Advanced, and set the login
# methods you want. Leave empty to use dev login only.
NEXT_PUBLIC_PRIVY_APP_ID=""
PRIVY_APP_SECRET=""
# Optional: verification key from Configuration > App settings (skips a lookup).
PRIVY_VERIFICATION_KEY=""
# Sign-in without a wallet signature (random test wallet). Always on in
# development; on Vercel set BOTH to "true" until Privy is configured, then
# remove them.
DEV_LOGIN="true"
NEXT_PUBLIC_DEV_LOGIN="true"

# --- $DROPS token ---
# Mint address of the $DROPS token on Solana. Leave empty until launch; the
# app shows "Launching soon" and swaps in the DexScreener chart once set.
NEXT_PUBLIC_DROPS_TOKEN=""
