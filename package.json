{
  "name": "money-drops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "treasury:new": "tsx scripts/new-treasury.ts",
    "setup": "node scripts/ensure-env.mjs && npm run db:push && npm run db:seed",
    "postinstall": "prisma generate && node scripts/copy-maplibre-worker.mjs",
    "dev:webpack": "next dev --webpack"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@privy-io/node": "^0.35.0",
    "@privy-io/react-auth": "^3.48.1",
    "@solana-program/memo": "^0.10.0",
    "@solana-program/system": "^0.10.0",
    "@solana-program/token": "^0.9.0",
    "@solana/kit": "^5.5.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.55.0",
    "maplibre-gl": "^6.14.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
