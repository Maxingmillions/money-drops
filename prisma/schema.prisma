// Money Drops data model.
//
// Money amounts are stored as integer USDC cents (1 USDC = 100 cents).
// On-chain USDC has 6 decimals, so cents * 10_000 = base units.
//
// Database: Postgres (Neon on Vercel, or any Postgres locally).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection for `prisma db push` / migrations.
  // Neon's Vercel integration sets both variables; locally they can be the same.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        String   @id @default(cuid())
  /// Solana public key (base58) that receives payouts. Either an external
  /// wallet (Phantom, Solflare...) or the Privy embedded wallet.
  wallet    String   @unique
  /// Privy DID (did:privy:...). Null for dev-login users.
  privyId   String?  @unique
  email     String?
  /// How the user first signed in: wallet | google | apple | email | dev ...
  loginMethod String?
  handle    String?  @unique
  /// USER | MOD | ADMIN. Mods review bounty submissions.
  role      String   @default("USER")
  createdAt DateTime @default(now())

  campaigns   Campaign[]
  claims      Claim[]
  bounties    Bounty[]
  submissions Submission[]
  reviews     Submission[] @relation("reviewer")
  messages    Message[]
}

/// A drop campaign: one "Hide money" action that scatters many drops.
model Campaign {
  id        String  @id @default(cuid())
  creatorId String
  creator   User    @relation(fields: [creatorId], references: [id])
  title     String
  /// PROXIMITY: always-on until all drops are claimed.
  /// EVENT: drops are only visible and claimable inside the time window.
  kind      String  @default("PROXIMITY")
  status    String  @default("DRAFT") // DRAFT | ACTIVE | ENDED | REFUNDED

  totalCents     Int
  perPersonLimit Int @default(1)
  /// Hunters see a search circle of this radius; the real spot is somewhere inside.
  searchRadiusM  Int @default(80)
  /// Exact drop location is revealed once a hunter is within this many metres.
  revealRadiusM  Int @default(30)
  /// A claim is accepted when the hunter is within this many metres.
  claimRadiusM   Int @default(15)

  centerLat Float
  centerLng Float
  radiusM   Int
  areaName  String?

  startsAt DateTime?
  endsAt   DateTime?

  /// Custodial escrow (v1): USDC is sent to the treasury wallet with the
  /// campaign id in the memo. fundingTxSig is the verified deposit.
  fundingTxSig String? @unique
  fundedAt     DateTime?
  refundTxSig  String?

  createdAt DateTime @default(now())

  drops  Drop[]
  claims Claim[]
}

model Drop {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  amountCents Int
  lat        Float
  lng        Float
  status     String   @default("HIDDEN") // HIDDEN | CLAIMED | RETURNED
  claim      Claim?
  createdAt  DateTime @default(now())

  @@index([campaignId, status])
  @@index([lat, lng])
}

model Claim {
  id         String   @id @default(cuid())
  dropId     String   @unique
  drop       Drop     @relation(fields: [dropId], references: [id])
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  amountCents Int
  lat        Float
  lng        Float
  distanceM  Float
  /// PENDING | PAID | FAILED
  payoutStatus String  @default("PENDING")
  payoutTxSig  String?
  payoutError  String?
  createdAt  DateTime @default(now())

  @@unique([campaignId, userId, dropId])
  @@index([userId])
}


/// One-time nonces for Sign-In With Solana (native wallet login).
model Nonce {
  value     String    @id
  wallet    String
  expiresAt DateTime
  usedAt    DateTime?
}

/// A bounty: go somewhere, do something, prove it on video, get paid.
model Bounty {
  id          String   @id @default(cuid())
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id])
  title       String
  description String
  rewardCents Int
  /// Optional place the task must happen.
  lat         Float?
  lng         Float?
  radiusM     Int?
  areaName    String?
  deadline    DateTime?
  /// How many approved submissions get paid (each gets rewardCents).
  maxWinners  Int      @default(1)
  /// DRAFT (unfunded) | OPEN | COMPLETED | CLOSED | REFUNDED
  status      String   @default("DRAFT")
  fundingTxSig String? @unique
  fundedAt    DateTime?
  createdAt   DateTime @default(now())

  submissions Submission[]

  @@index([status, createdAt])
}

model Submission {
  id         String   @id @default(cuid())
  bountyId   String
  bounty     Bounty   @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  /// Link to the proof video (YouTube, TikTok, X, Drive...).
  videoUrl   String
  note       String?
  /// PENDING | APPROVED | REJECTED
  status     String   @default("PENDING")
  reviewerId String?
  reviewer   User?    @relation("reviewer", fields: [reviewerId], references: [id])
  reviewNote String?
  reviewedAt DateTime?
  payoutStatus String  @default("PENDING")
  payoutTxSig  String?
  payoutError  String?
  createdAt  DateTime @default(now())

  @@unique([bountyId, userId])
  @@index([status, createdAt])
}

/// Chat messages. `room` is "global" for now; per-city rooms later.
model Message {
  id        String   @id @default(cuid())
  room      String   @default("global")
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([room, createdAt])
}
