// Money Drops data model.
//
// Money amounts are SOL stored as integer lamports (1 SOL = 1e9 lamports)
// in Float columns: doubles hold integers exactly up to 2^53, far beyond
// any plausible amount, and stay JSON-friendly.
//
// Database: Postgres (Neon on Vercel, or any Postgres locally).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection for `prisma db push` / migrations.
  // Neon's Vercel integration sets both variables; locally they can be the same.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        String   @id @default(cuid())
  /// Solana public key (base58) that receives payouts. Either an external
  /// wallet (Phantom, Solflare...) or the Privy embedded wallet.
  wallet    String   @unique
  /// Privy DID (did:privy:...). Null for dev-login users.
  privyId   String?  @unique
  email     String?  @unique
  /// OAuth subject ids for social sign-in.
  googleId  String?  @unique
  appleId   String?  @unique
  /// bcrypt hash for email + password accounts.
  passwordHash String?
  /// Encrypted secret key of the custodial wallet we created for accounts
  /// that signed up without a wallet (email). Null for external wallets.
  custodialSecret String?
  /// How the user first signed in: wallet | email | google | apple | dev ...
  loginMethod String?
  handle    String?  @unique
  /// Last reported position (from the hunt map) so pool drops land near people.
  lastLat    Float?
  lastLng    Float?
  lastSeenAt DateTime?
  /// USER | MOD | ADMIN. Mods review bounty submissions.
  role      String   @default("USER")
  createdAt DateTime @default(now())

  campaigns   Campaign[]
  claims      Claim[]
  bounties    Bounty[]
  submissions Submission[]
  reviews     Submission[] @relation("reviewer")
  messages    Message[]
}

/// A drop campaign: one "Hide money" action that scatters many drops.
model Campaign {
  id        String  @id @default(cuid())
  creatorId String
  creator   User    @relation(fields: [creatorId], references: [id])
  title     String
  /// PROXIMITY: always-on until all drops are claimed.
  /// EVENT: drops are only visible and claimable inside the time window.
  kind      String  @default("PROXIMITY")
  status    String  @default("DRAFT") // DRAFT | ACTIVE | ENDED | REFUNDED

  totalLamports  Float @default(0)
  perPersonLimit Int @default(1)
  /// Hunters see a search circle of this radius; the real spot is somewhere inside.
  searchRadiusM  Int @default(80)
  /// Exact drop location is revealed once a hunter is within this many metres.
  revealRadiusM  Int @default(30)
  /// A claim is accepted when the hunter is within this many metres.
  claimRadiusM   Int @default(15)

  centerLat Float
  centerLng Float
  radiusM   Int
  areaName  String?

  startsAt DateTime?
  endsAt   DateTime?

  /// Custodial escrow (v1): USDC is sent to the treasury wallet with the
  /// campaign id in the memo. fundingTxSig is the verified deposit.
  fundingTxSig String? @unique
  fundedAt     DateTime?
  refundTxSig  String?
  /// Set when a mod takes the campaign down.
  modNote      String?
  refundedLamports Float?

  createdAt DateTime @default(now())

  drops  Drop[]
  claims Claim[]
}

model Drop {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  amountLamports Float @default(0)
  lat        Float
  lng        Float
  status     String   @default("HIDDEN") // HIDDEN | CLAIMED | RETURNED
  claim      Claim?
  createdAt  DateTime @default(now())

  @@index([campaignId, status])
  @@index([lat, lng])
}

model Claim {
  id         String   @id @default(cuid())
  dropId     String   @unique
  drop       Drop     @relation(fields: [dropId], references: [id])
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  amountLamports Float @default(0)
  lat        Float
  lng        Float
  distanceM  Float
  /// PENDING | PAID | FAILED
  payoutStatus String  @default("PENDING")
  payoutTxSig  String?
  payoutError  String?
  createdAt  DateTime @default(now())

  @@unique([campaignId, userId, dropId])
  @@index([userId])
}


/// One-time nonces for Sign-In With Solana (native wallet login).
model Nonce {
  value     String    @id
  wallet    String
  expiresAt DateTime
  usedAt    DateTime?
}

/// A bounty: go somewhere, do something, prove it on video, get paid.
model Bounty {
  id          String   @id @default(cuid())
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id])
  title       String
  description String
  rewardLamports Float @default(0)
  /// Optional place the task must happen.
  lat         Float?
  lng         Float?
  radiusM     Int?
  areaName    String?
  deadline    DateTime?
  /// How many approved submissions get paid (each gets rewardLamports).
  maxWinners  Int      @default(1)
  /// DRAFT (unfunded) | OPEN | COMPLETED | CLOSED | REFUNDED
  status      String   @default("DRAFT")
  fundingTxSig String? @unique
  fundedAt    DateTime?
  refundTxSig String?
  refundedLamports Float?
  /// Set when a mod takes the bounty down.
  modNote     String?
  createdAt   DateTime @default(now())

  submissions Submission[]

  @@index([status, createdAt])
}

model Submission {
  id         String   @id @default(cuid())
  bountyId   String
  bounty     Bounty   @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  /// Optional link to the proof video (YouTube, TikTok, X, Drive...).
  videoUrl   String?
  /// Up to 3 uploaded proofs: [{ pathname, contentType, size, name }].
  /// Served through /api/files, which only lets mods, the submitter and the
  /// creator see them until the submission is approved.
  files      Json     @default("[]")
  note       String?
  /// PENDING | APPROVED | REJECTED
  status     String   @default("PENDING")
  reviewerId String?
  reviewer   User?    @relation("reviewer", fields: [reviewerId], references: [id])
  reviewNote String?
  reviewedAt DateTime?
  payoutStatus String  @default("PENDING")
  payoutTxSig  String?
  payoutError  String?
  createdAt  DateTime @default(now())

  @@unique([bountyId, userId])
  @@index([status, createdAt])
}

/// Chat messages. `room` is "global" for now; per-city rooms later.
model Message {
  id        String   @id @default(cuid())
  room      String   @default("global")
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([room, createdAt])
}

/// Platform fee ledger and the community drop pool (single row, id "main").
model Pool {
  id                 String   @id @default("main")
  balanceLamports    Float    @default(0)
  feesCollectedLamports Float @default(0)
  poolCollectedLamports Float @default(0)
  droppedLamports    Float    @default(0)
  runs               Int      @default(0)
  lastRunAt          DateTime?
  updatedAt          DateTime @updatedAt
}

/// One row per fee taken or pool drop made.
model PoolEvent {
  id        String   @id @default(cuid())
  kind      String   // FEE | DROP
  lamports  Float
  /// For FEE: the half that went to the pool. For DROP: equals lamports.
  poolLamports Float
  source    String?  // "campaign:<id>" | "bounty:<id>"
  campaignId String?
  areaName  String?
  onChain   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
